#!/bin/sh
# Git hook (pre-commit): runs before every commit, including the ones made by hand.
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit
#          chmod +x .git/hooks/pre-commit
# Fails closed (Part 06): without gitleaks, the commit stops and the message says what to do.

# 1. Conflict markers forgotten in a merge
markers=$(git diff --cached --name-only --diff-filter=ACM -z |
  xargs -0 -r grep -lE '^(<<<<<<<|>>>>>>>)( |$)|^=======$' -- 2>/dev/null)
if [ -n "$markers" ]; then
  echo "Commit blocked: conflict marker in:" >&2
  echo "$markers" >&2
  exit 1
fi

# 2. Secrets in the staged files
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Commit blocked: gitleaks not found. Install it (Part 06)." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact >&2 || exit 1
