#!/bin/sh
# Blocks direct pushes to main (local protection, no paid plan needed).
# Install: cp scripts/hooks/pre-push .git/hooks/pre-push
#          chmod +x .git/hooks/pre-push
while read -r _ _ remote_ref _; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "BLOCKED: direct push to main. Use a branch and do a reviewed merge."
      exit 1;;
  esac
done
exit 0
