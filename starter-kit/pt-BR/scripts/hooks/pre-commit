#!/bin/sh
# Hook do Git (pre-commit): roda antes de todo commit, inclusive os feitos à mão.
# Instalar: cp scripts/hooks/pre-commit .git/hooks/pre-commit
#           chmod +x .git/hooks/pre-commit
# Fail closed (Parte 06): sem o gitleaks, o commit para e a mensagem diz o que fazer.

# 0. Agentes do Claude Code: frontmatter inválido faz o agente sumir em silêncio (Parte 03)
agentes=$(git diff --cached --name-only --diff-filter=ACM -- '.claude/agents/*.md')
for f in $agentes; do
  if [ "$(head -n 1 "$f" | tr -d '\r')" != "---" ]; then
    printf "Commit bloqueado: %s não começa com '---' (o Claude Code ignoraria o agente)\n" "$f" >&2
    exit 1
  fi
  if [ "$(tr -d '\r' < "$f" | grep -c '^---$')" -lt 2 ]; then
    printf "Commit bloqueado: %s não fecha o frontmatter com '---'\n" "$f" >&2
    exit 1
  fi
  cabecalho=$(tr -d '\r' < "$f" | awk 'NR > 1 && /^---$/ { exit } NR > 1 { print }')
  if ! printf '%s\n' "$cabecalho" | grep -q '^name:' || ! printf '%s\n' "$cabecalho" | grep -q '^description:'; then
    printf "Commit bloqueado: %s precisa de name: e description: no frontmatter\n" "$f" >&2
    exit 1
  fi
  for t in $(printf '%s\n' "$cabecalho" | sed -n 's/^tools:[[:space:]]*//p' | tr ',' ' '); do
    case "$t" in
      Read|Write|Edit|MultiEdit|Grep|Glob|Bash|PowerShell|WebFetch|WebSearch|Agent|Task|NotebookEdit|TodoWrite|Skill|ToolSearch|Monitor|mcp__*) ;;
      *) printf "Aviso: %s cita ferramenta desconhecida: %s (confira o nome)\n" "$f" "$t" >&2 ;;
    esac
  done
done

# 1. Marcadores de conflito esquecidos num merge
marcadores=$(git diff --cached --name-only --diff-filter=ACM -z |
  xargs -0 -r grep -lE '^(<<<<<<<|>>>>>>>)( |$)|^=======$' -- 2>/dev/null)
if [ -n "$marcadores" ]; then
  echo "Commit bloqueado: marcador de conflito em:" >&2
  echo "$marcadores" >&2
  exit 1
fi

# 2. Segredos nos arquivos preparados
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Commit bloqueado: gitleaks não encontrado. Instale-o (Parte 06)." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact >&2 || exit 1
